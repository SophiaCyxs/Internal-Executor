		X.libRefresh, X.setParticles, X.layout, X.setNames, X.paintProviders, X.rebuildThemes, X.placeToggle = function() end, function() end, function() end, function() end, function() end, function() end, function() end

		local Win = new("Frame", { Name = "Win", Size = UDim2.fromScale(S.wsize, S.wsize), AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), BorderSizePixel = 0, Visible = false, ClipsDescendants = true }, Root)
		X.Win = Win
		corner(14, Win) surf(Win, 0, C.bg) U.glow(Win)
		local WS = new("UIScale", { Scale = 0.9 }, Win)

		do -- particles
			local PL = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0 }, Win)
			local parts = {}
			function X.setParticles()
				for _, p in ipairs(parts) do p.f:Destroy() end
				parts = {}
				if not S.particles then return end
				for i = 1, S.pcount do
					local sz = math.random(2, 4)
					local f = new("Frame", { Size = UDim2.fromOffset(sz, sz), AnchorPoint = V2(0.5, 0.5), BackgroundColor3 = U.A1, BackgroundTransparency = 0.35 + math.random() * 0.45, BorderSizePixel = 0 }, PL)
					corner(4, f)
					parts[i] = { f = f, x = math.random(), y = math.random(), vx = (math.random() - 0.5) * 0.03, vy = -(0.012 + math.random() * 0.04), k = i / S.pcount }
				end
			end
			U.hooks[#U.hooks + 1] = function(dt, t)
				for _, p in ipairs(parts) do
					p.x = (p.x + p.vx * dt + math.sin(t * 0.5 + p.k * 20) * 0.0006) % 1
					p.y = (p.y + p.vy * dt) % 1
					p.f.Position = UDim2.fromScale(p.x, p.y)
					p.f.BackgroundColor3 = U.A1:Lerp(U.A2, p.k)
				end
			end
			X.setParticles()
		end

