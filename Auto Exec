		"request", "cloneref", "gethui", "Drawing", "WebSocket", "crypt", "queue_on_teleport", "setfpscap", "getrawmetatable", "setreadonly" }
	local function uncCheck()
		local have, miss = 0, {}
		for _, n in ipairs(UNC) do
			local ok, v = pcall(function() local f = loadstring("return " .. n) return f and f() end)
			if ok and v ~= nil then have = have + 1 else miss[#miss + 1] = n end
		end
		return have, #UNC, miss
	end

	-- ===== key session (memory only) =====
	local SESSION
	local function writeSession(p) SESSION = { provider = p.id, exp = (p.hours or 0) > 0 and os.time() + p.hours * 3600 or 0 } end
	function U.expText()
		if not SESSION or SESSION.exp == 0 then return "Lifetime" end
		local d = SESSION.exp - os.time()
		if d <= 0 then return "expired" end
		return string.format("%dh %02dm", math.floor(d / 3600), math.floor((d % 3600) / 60))
	end
	local function redeem(p, key)
		if p.key then local ok = key == p.key return ok, ok and "key accepted" or "invalid key" end
		if not p.verifyUrl then return false, "provider not configured" end
		local hwid = ""
		pcall(function() hwid = Sv.RbxAnalyticsService:GetClientId() end)
		local url = (p.verifyUrl:gsub("{key}", function() return enc(key) end):gsub("{hwid}", function() return enc(hwid) end))
		local ok, body = pcall(httpGet, url)
		if not ok then return false, "provider unreachable" end
		local okj, j = pcall(Sv.HttpService.JSONDecode, Sv.HttpService, body)
		local good
		if okj and type(j) == "table" then good = j[p.okField or "valid"] == true or j.success == true
		else good = tostring(body):lower():match("^%s*true%s*$") ~= nil end
		return good, good and "key redeemed" or "invalid or expired key"
	end

	-- ===== sound line visualizer (decor) =====
	function U.makeViz(par, n, bw)
		local bars = {}
		for i = 1, n do
			local b = new("Frame", { AnchorPoint = V2(0.5, 0.5), Position = UDim2.new((i - 0.5) / n, 0, 0.5, 0), Size = UDim2.new(0, bw, 0.1, 0), BackgroundColor3 = U.A1, BorderSizePixel = 0 }, par)
			U.corner(2, b)
			bars[i] = { f = b, h = 0.1 }
		end
		local beat, nextBeat = 0, 0
		return function(dt, t, boost)
			if not S.anim then return end
			if t >= nextBeat then beat, nextBeat = 1, t + 0.38 + math.random() * 0.2 end
			beat = math.max(0, beat - dt * 3)
			for i, b in ipairs(bars) do
				local x = i / n
				local tgt = 0.12 + 0.5 * math.abs(math.sin(t * 2.7 + i * 0.6)) * math.abs(math.sin(t * 1.3 + i * 0.23)) + 0.3 * beat * (1 - math.abs(x - 0.5) * 1.4) + (boost or 0) * math.abs(math.sin(i * 1.7 + t * 9))
				b.h = b.h + (math.min(tgt, 1) - b.h) * math.min(dt * 14, 1)
				b.f.Size = UDim2.new(0, bw, b.h, 0)
				b.f.BackgroundColor3 = U.A1:Lerp(U.A2, x)
			end
		end
	end

