				r.MouseButton1Click:Connect(function() accept(it) end)
				popRows[i] = r
			end
			local nl = select(2, before:gsub("\n", "\n"))
			local col = #before - (before:match(".*()\n") or 0) - #word
			local h = #res * 26 + 8
			local x = math.clamp(38 + col * cw, 4, math.max(wrap.AbsoluteSize.X - 234, 4))
