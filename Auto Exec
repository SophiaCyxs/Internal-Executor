					pending = pending + 1
					task.spawn(function()
						local ok = pcall(P[id].fetch, "", 1)
						U.pstat[id] = ok
						if ok then okc = okc + 1 end
						log(P[id].name .. (ok and " online" or " unavailable"), ok and C.green or C.red)
						pending = pending - 1
					end)
				end
			end
			local t0 = os.clock()
			while pending > 0 and os.clock() - t0 < 6 do task.wait(0.1) end
			return okc .. " online"
		end },
	}
	local stagesC = {
		{ "Session", function(log)
			log("expires: " .. U.expText(), C.sub)
			return U.expText()
		end },
		{ "Interface", function(log)
			local ok, r = pcall(build)
			if not ok then bootErr = tostring(r) error(r, 0) end
			reveal = r
			log("window and pages built", C.green)
			return "built"
		end },
		{ "Launch", function(log)
			log(reveal and ("ready, toggle key " .. S.key) or "interface missing", reveal and C.green or C.red)
			task.wait(0.15)
		end },
	}
	bootstrap("startup", stagesA, function()
		keyGate(function()
			bootstrap("launch", stagesC, function()
				if reveal then
					U.tw(Backdrop, { BackgroundTransparency = 1 }, 0.4, function() Backdrop:Destroy() end)
					reveal()
				else
					U.fatal(bootErr or "build returned nothing")
				end
			end)
		end)
	end)
end

local ok, err = xpcall(main, debug.traceback)
if not ok then
	warn("[Arachnid] fatal: " .. tostring(err))
	pcall(function()
		local g = Instance.new("ScreenGui")
		g.ResetOnSpawn = false
		g.Parent = (gethui and gethui()) or game:GetService("CoreGui")
		local t = Instance.new("TextLabel")
		t.Size, t.Position, t.BackgroundColor3, t.TextColor3 = UDim2.fromOffset(460, 220), UDim2.fromOffset(20, 60), Color3.fromRGB(20, 20, 24), Color3.fromRGB(255, 120, 120)
		t.TextWrapped, t.TextXAlignment, t.TextYAlignment, t.TextSize, t.Font = true, Enum.TextXAlignment.Left, Enum.TextYAlignment.Top, 11, Enum.Font.Code
		t.Text = "Arachnid fatal:\n" .. tostring(err):sub(1, 900)
		t.Parent = g
		task.delay(30, function() g:Destroy() end)
	end)
end
