		local shim = new("Frame", { Size = UDim2.fromOffset(70, 6), Position = UDim2.fromOffset(-70, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, trk)
		new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.65), NumberSequenceKeypoint.new(1, 1) }) }, shim)
		if S.anim then Sv.TweenService:Create(shim, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1), { Position = UDim2.fromOffset(404, 0) }):Play() end
