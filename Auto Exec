		local vz = U.makeViz(vzf, 48, 3)
		local t0 = os.clock()
		local bc = U.track(Sv.RunService.Heartbeat:Connect(function(dt)
			vz(dt, os.clock(), 0.15)
			elapsed.Text = string.format("%.1fs", os.clock() - t0)
		end))
		local rows = {}
		for i, s in ipairs(stages) do
			local y = 92 + (i - 1) * 22
			local mk = new("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(20, y + 4), BackgroundColor3 = C.hover, BorderSizePixel = 0 }, Card)
