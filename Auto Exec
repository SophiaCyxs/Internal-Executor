	-- ===== helpers =====
	function U.track(c) U.conns[#U.conns + 1] = c return c end
	function U.new(cls, props, par)
		local o = Instance.new(cls)
		for k, v in pairs(props or {}) do o[k] = v end
		if par then o.Parent = par end
		return o
	end
	local new = U.new
	function U.tw(o, props, t, cb, style)
		if not S.anim then
			for k, v in pairs(props) do o[k] = v end
			if cb then task.defer(cb) end
			return nil
		end
		local tween = Sv.TweenService:Create(o, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
		if cb then tween.Completed:Connect(function() cb() end) end
		tween:Play()
		return tween
	end
	function U.corner(r, p) return new("UICorner", { CornerRadius = UDim.new(0, r) }, p) end
	function U.pad(l, r, t, b, p)
		return new("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingRight = UDim.new(0, r), PaddingTop = UDim.new(0, t), PaddingBottom = UDim.new(0, b) }, p)
	end
	function U.stroke(col, th, p) return new("UIStroke", { Color = col, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p) end
	function U.lbl(txt, sz, col, props, par)
		local p = props or {}
		p.Text, p.TextSize, p.TextColor3, p.BackgroundTransparency = txt, sz, col, 1
		p.Font = p.Font or Enum.Font.GothamMedium
		p.TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Left
		return new("TextLabel", p, par)
	end
	function U.roleOf(col) for k in pairs(TINTED) do if C[k] == col then return k end end end
	function U.btn(txt, sz, bg, tc, props, par)
		local p = props or {}
		p.Text, p.TextSize, p.TextColor3, p.BackgroundColor3 = txt, sz, tc, bg
		p.Font = p.Font or Enum.Font.GothamBold
		p.AutoButtonColor, p.BorderSizePixel = false, 0
		local b = new("TextButton", p, par)
		U.corner(7, b)
		local sc = new("UIScale", {}, b)
		local role = U.roleOf(bg)
		local e = role and { o = b, p = "BackgroundColor3", r = role, hov = false }
		if e then U.roles[#U.roles + 1] = e b.BackgroundColor3 = T[role] end
		local function base() return e and T[role] or bg end
		b.MouseEnter:Connect(function() if e then e.hov = true end U.tw(b, { BackgroundColor3 = base():Lerp(WHITE, 0.12) }, 0.12) end)
		b.MouseLeave:Connect(function() if e then e.hov = false end U.tw(b, { BackgroundColor3 = base() }, 0.12) U.tw(sc, { Scale = 1 }, 0.1) end)
		b.MouseButton1Down:Connect(function() U.tw(sc, { Scale = 0.94 }, 0.08) end)
		b.MouseButton1Up:Connect(function()
			U.tw(sc, { Scale = 1 }, 0.18, nil, Enum.EasingStyle.Back)
			task.delay(0.3, function() if e then e.hov = false end end)
		end)
		return b
	end
	function U.field(ph, par, props)
		local p = props or {}
		p.BackgroundColor3, p.Text, p.PlaceholderText, p.PlaceholderColor3 = T.card, "", ph, C.mute
		p.TextColor3, p.TextSize, p.Font, p.ClearTextOnFocus, p.BorderSizePixel = C.text, 12, Enum.Font.GothamMedium, false, 0
		p.TextXAlignment = Enum.TextXAlignment.Left
		local b = new("TextBox", p, par)
		U.roles[#U.roles + 1] = { o = b, p = "BackgroundColor3", r = "card" }
		U.corner(10, b) U.pad(12, 12, 0, 0, b) U.stroke(C.line, 1, b)
		return b
	end
	function U.bind(o, p, fn) U.binds[#U.binds + 1] = { o, p, fn } o[p] = fn() return o end
	function U.isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
	function U.isMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end
	function U.vpScale(h)
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or V2(800, 600)
		return math.clamp(math.min(vp.X / 460, vp.Y / ((h or 400) + 40)), 0.5, 1)
	end
	function U.ink()
		local c = U.A1:Lerp(U.A2, 0.5)
		return (c.R * 0.299 + c.G * 0.587 + c.B * 0.114) > 0.6 and C.bg or WHITE
	end
	function U.nameOf(path) return (path:gsub("\\", "/"):match("([^/]+)$")) or path end
	function U.logo(par, size, props)
