				X.libRefresh()
			end)
		end
		function X.libRefresh()
			for _, c in ipairs(LL:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
			local files = {}
			pcall(function()
				for _, p in ipairs(listfiles(K.folder)) do
					local n = U.nameOf(p)
					if n:match("%.luau?$") or n:match("%.txt$") then
						local ok, src = pcall(readfile, p)
						src = ok and src or ""
						files[#files + 1] = { name = n, path = p, size = #src, lines = select(2, src:gsub("\n", "\n")) + 1 }
					end
				end
			end)
			local list = {}
			if tab == 3 then
				for _, n in ipairs(S.recent) do for _, f in ipairs(files) do if f.name == n then list[#list + 1] = f end end end
			else
				for _, f in ipairs(files) do if tab == 1 or S.fav[f.name] then list[#list + 1] = f end end
				table.sort(list, function(a, b) return a.name:lower() < b.name:lower() end)
			end
			local shown = 0
			for _, f in ipairs(list) do
				if q == "" or f.name:lower():find(q:lower(), 1, true) then
					shown = shown + 1
					if shown > 60 then break end
					row(f, shown)
				end
			end
			if shown == 0 then lbl(tab == 2 and "no favorites yet" or tab == 3 and "nothing run yet" or "no saved scripts, use Save in Editor or Hub", 11, C.mute, { Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center }, LL) end
		end
		for i, nm in ipairs({ "Saved", "Favorites", "Recent" }) do
			local b = btn(nm, 10, C.card, C.sub, { Size = UDim2.fromOffset(84, 26) }, tabsF)
			bind(b, "BackgroundColor3", function() return tab == i and U.A1:Lerp(C.bg, 0.72) or T.card end)
			bind(b, "TextColor3", function() return tab == i and C.text or C.sub end)
			b.MouseButton1Click:Connect(function() tab = i X.libRefresh() end)
		end
		track(sb:GetPropertyChangedSignal("Text"):Connect(function() q = sb.Text X.libRefresh() end))
		rf.MouseButton1Click:Connect(X.libRefresh)
		X.onShow.Library = X.libRefresh
	end

