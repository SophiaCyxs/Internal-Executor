		accentG(TopBar, 0)
		local Body = new("Frame", { Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52), BackgroundTransparency = 1 }, Win)
		local SB = new("ScrollingFrame", { Size = UDim2.new(0, 56, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, Body)
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, SB)
		pad(0, 0, 6, 6, SB)
		new("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(0, 56, 0, 0), BackgroundColor3 = C.line, BackgroundTransparency = 0.4, BorderSizePixel = 0 }, Body)
		local CP = new("Frame", { Size = UDim2.new(1, -57, 1, 0), Position = UDim2.fromOffset(57, 0), BackgroundTransparency = 1 }, Body)

		local navSet = function() end
		function X.page(name)
			local p = new("Frame", { Name = name, Size = UDim2.new(1, -24, 1, -24), Position = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, Visible = false }, CP)
			X.pages[name] = p
			return p
		end
		function X.scroller(par, pd)
			local s = new("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = C.line, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, par)
			new("UIListLayout", { Padding = UDim.new(0, pd or 8), SortOrder = Enum.SortOrder.LayoutOrder }, s)
			return s
		end
		function X.hrow(par, h, order)
			local r = new("ScrollingFrame", { Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, LayoutOrder = order }, par)
			new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, r)
			return r
		end
		function X.switch(name)
			if X.cur == name or not X.pages[name] then return end
			for n, p in pairs(X.pages) do if n ~= name then p.Visible = false end end
			local p = X.pages[name]
			p.Position = UDim2.fromOffset(12, 24)
			p.Visible = true
			tw(p, { Position = UDim2.fromOffset(12, 12) }, 0.3)
			X.cur = name
			navSet(name)
			if X.onShow[name] then pcall(X.onShow[name]) end
			if name == "Hub" and X.hubFirst then local f = X.hubFirst X.hubFirst = nil f() end
		end
		function X.runCode(src, label)
			local fn, e = loadstring(src, "=" .. label)
			if not fn then U.notify("compile error", C.red) warn("[Arachnid] " .. tostring(e)) return end
			task.spawn(function()
				local ok, e2 = pcall(fn)
				if ok then U.notify("ran " .. label, C.green) else U.notify("run error", C.red) warn("[Arachnid] " .. tostring(e2)) end
			end)
		end
		function X.runFile(name)
			local ok, src = pcall(readfile, K.folder .. "/" .. name)
			if not ok then U.notify("read failed", C.red) return end
			U.pushRecent(name)
			X.runCode(src, name)
		end
		function X.cgrid(par, o)
			local g = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = o }, par)
			new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 66), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, g)
			return g
		end
		function X.controls(grid)
			local order = 0
			local function cell(name)
				order = order + 1
				local c = new("Frame", { LayoutOrder = order, BorderSizePixel = 0 }, grid)
				corner(10, c) surf(c, 0.05, C.card)
				lbl(name, 11, C.text, { Size = UDim2.new(1, -20, 0, 16), Position = UDim2.fromOffset(12, 8), Font = Enum.Font.GothamBold, TextTruncate = Enum.TextTruncate.AtEnd }, c)
				return c
			end
			local function toggle(name, key, cb)
				local c = cell(name)
				local tr = new("TextButton", { Size = UDim2.fromOffset(42, 22), Position = UDim2.fromOffset(12, 34), Text = "", AutoButtonColor = false, BorderSizePixel = 0, BackgroundColor3 = C.hover }, c)
				corner(11, tr)
				bind(tr, "BackgroundColor3", function() return S[key] and U.A1:Lerp(C.bg, 0.25) or T.hover end)
				local kn = new("Frame", { Size = UDim2.fromOffset(16, 16), BackgroundColor3 = C.text, BorderSizePixel = 0 }, tr)
				corner(8, kn)
				local function paint(instant)
					local pos = S[key] and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
					if instant then kn.Position = pos else tw(kn, { Position = pos }, 0.22, nil, Enum.EasingStyle.Back) end
