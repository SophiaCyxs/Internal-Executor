		for _, s in ipairs(SN) do ITEMS[#ITEMS + 1] = { name = s[1], body = s[2], kind = "Snippet", pr = 1 } end
		for _, w in ipairs(KW) do ITEMS[#ITEMS + 1] = { name = w, kind = "Keyword", pr = 2 } end
