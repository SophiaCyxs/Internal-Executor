			ln = ln + 1
			U.lbl("> " .. msg, 9, col or C.sub, { Size = UDim2.new(1, 0, 0, 11), Font = Enum.Font.Code, LayoutOrder = ln, TextTruncate = Enum.TextTruncate.AtEnd }, LB)
			local kids = {}
			for _, c in ipairs(LB:GetChildren()) do if c:IsA("TextLabel") then kids[#kids + 1] = c end end
			table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
			while #kids > 4 do table.remove(kids, 1):Destroy() end
		end
		local pY = 164 + 22 * n
		local trk = new("Frame", { Size = UDim2.new(1, -36, 0, 6), Position = UDim2.fromOffset(18, pY), BackgroundColor3 = C.card, BorderSizePixel = 0, ClipsDescendants = true }, Card)
