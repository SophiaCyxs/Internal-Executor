		p.Size, p.BackgroundColor3, p.BorderSizePixel = UDim2.fromOffset(size, size), C.bg, 0
		local f = new("Frame", p, par)
		U.corner(size, f)
		new("ImageLabel", { Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3), BackgroundTransparency = 1, Image = K.logo, ScaleType = Enum.ScaleType.Fit, ZIndex = (p.ZIndex or 1) + 1 }, f)
		return f
	end

	-- ===== themes + palette =====
	function U.buildTH()
		U.TH = {}
		for _, t in ipairs(BASE) do U.TH[#U.TH + 1] = t end
		for mi, m in ipairs(S.mythemes) do
			local ok1, a = pcall(Color3.fromHex, m.a)
			local ok2, b = pcall(Color3.fromHex, m.b)
			if ok1 and ok2 then U.TH[#U.TH + 1] = { name = m.n, c1 = a, c2 = b, user = true, mi = mi } end
		end
		if not U.TH[S.theme] then S.theme = 1 end
	end
	U.buildTH()
	function U.customCols()
		local ok1, a = pcall(Color3.fromHex, S.c1)
		local ok2, b = pcall(Color3.fromHex, S.c2)
		return ok1 and a or rgb(139, 92, 246), ok2 and b or rgb(56, 189, 248)
	end
	function U.pal(t)
		local th = U.TH[S.theme] or U.TH[1]
		if th.rainbow then
			local h = S.anim and (t * 0.07 * S.cspeed) % 1 or 0.75
			return Color3.fromHSV(h, 0.6, 1), Color3.fromHSV((h + 0.18) % 1, 0.6, 1)
		end
		local c1, c2 = th.c1, th.c2
		if th.custom then c1, c2 = U.customCols() end
		if S.anim then
			local m = (math.sin(t * 1.4 * S.cspeed) + 1) / 2
			return c1:Lerp(c2, m), c2:Lerp(c1, m)
		end
		return c1, c2
	end
	local function seqAcc(three)
		if not S.grad then return ColorSequence.new(U.A1) end
		if three then return ColorSequence.new({ ColorSequenceKeypoint.new(0, U.A1), ColorSequenceKeypoint.new(0.5, U.A2), ColorSequenceKeypoint.new(1, U.A1) }) end
		return ColorSequence.new(U.A1, U.A2)
	end

	-- ===== surfaces, accents, glow =====
	function U.paint(e)
		if not e.f.Parent then return end
		local gl = S.glass
		local base = T[e.role] or e.c
		e.f.BackgroundColor3 = gl and base:Lerp(WHITE, 0.05) or base
		e.f.BackgroundTransparency = gl and math.clamp(S.alpha + e.l, 0, 0.95) or 0
		e.g.Enabled = S.grad
		e.g.Color = ColorSequence.new(WHITE, gl and rgb(165, 165, 190) or rgb(190, 190, 200))
		e.g.Transparency = gl and NumberSequence.new(0, 0.2) or NumberSequence.new(0)
		e.st.Color = gl and WHITE or C.line
		e.st.Transparency = gl and 0.82 or 0
	end
	function U.surf(f, lvl, col)
		local e = { f = f, l = lvl or 0, c = col or C.card }
		e.role = U.roleOf(e.c)
		e.g = new("UIGradient", { Rotation = 90 }, f)
		e.st = new("UIStroke", { Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, f)
		U.surfs[#U.surfs + 1] = e
		U.paint(e)
		return e
	end
	function U.accentG(par, rot)
		local g = new("UIGradient", { Color = seqAcc(false), Rotation = rot or 0 }, par)
		U.accents[#U.accents + 1] = g
		return g
	end
	function U.spin(e)
		if e.tw then e.tw:Cancel() e.tw = nil end
		e.g.Rotation = 0
		if not S.anim then return end
		e.tw = Sv.TweenService:Create(e.g, TweenInfo.new(1 / math.max(S.speed, 0.1), Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { Rotation = 360 })
		e.tw:Play()
	end
	function U.glow(par, th)
		local st = new("UIStroke", { Thickness = th or S.thick, Color = WHITE, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, par)
		local g = new("UIGradient", {
			Color = seqAcc(true),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 1), NumberSequenceKeypoint.new(0.7, 1), NumberSequenceKeypoint.new(1, 0) }),
		}, st)
		local e = { g = g, st = st }
		U.glows[#U.glows + 1] = e
		U.spin(e)
		return st
	end

	local acc = 0
	U.track(Sv.RunService.Heartbeat:Connect(function(dt)
		local t = os.clock()
		U.A1, U.A2 = U.pal(t)
		acc = acc + dt
		if acc >= 1 / 30 then
			acc = 0
			local s3, s2 = seqAcc(true), seqAcc(false)
			local tc = U.A1:Lerp(Color3.new(0, 0, 0), 0.7)
			for k in pairs(TINTED) do T[k] = C[k]:Lerp(tc, S.tint * (k == "line" and 0.5 or 0.8)) end
			for _, e in ipairs(U.surfs) do
				if e.f.Parent and e.role then e.f.BackgroundColor3 = S.glass and T[e.role]:Lerp(WHITE, 0.05) or T[e.role] end
			end
			for i = #U.roles, 1, -1 do
				local r = U.roles[i]
				if r.o.Parent then if not r.hov then r.o[r.p] = T[r.r] end else table.remove(U.roles, i) end
			end
			for i = #U.glows, 1, -1 do
				local e = U.glows[i]
				if e.g.Parent then e.g.Color = s3 else if e.tw then e.tw:Cancel() end table.remove(U.glows, i) end
			end
			for i = #U.accents, 1, -1 do
				local g = U.accents[i]
				if g.Parent then g.Color = s2 else table.remove(U.accents, i) end
			end
			for i = #U.binds, 1, -1 do
				local b = U.binds[i]
				if b[1].Parent then b[1][b[2]] = b[3]() else table.remove(U.binds, i) end
			end
		end
		if U.open and S.anim then for _, h in ipairs(U.hooks) do h(dt, t) end end
	end))

	-- ===== icons (lucide) =====
	function U.loadIcons()
		local ok, t = pcall(function() return loadstring(game:HttpGet(K.icons, true))() end)
		local n = 0
		if ok and type(t) == "table" then
			if type(t.Icons) == "table" then t = t.Icons end
			U.IC = t
			for _ in pairs(t) do n = n + 1 end
		end
		return n
	end
	function U.icon(name, glyph, sz, col, par)
		local h = new("Frame", { Size = UDim2.fromOffset(sz, sz), BackgroundTransparency = 1 }, par)
		local img = new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ImageColor3 = col, Visible = false }, h)
		local txt = U.lbl(glyph, math.max(sz - 4, 8), col, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold, Visible = false }, h)
		local v = U.IC[name] or U.IC["lucide-" .. name]
		if type(v) == "string" then img.Image = v img.Visible = true
		elseif type(v) == "table" then
			img.Image = v.Image or v.image or v[1] or ""
			local rs, ro = v.ImageRectSize or v.size, v.ImageRectPosition or v.ImageRectOffset or v.position
			if typeof(rs) == "Vector2" then img.ImageRectSize = rs end
			if typeof(ro) == "Vector2" then img.ImageRectOffset = ro end
			img.Visible = true
		else txt.Visible = true end
		return { f = h, img = img, txt = txt }
	end
	function U.tint(i, col) U.tw(i.img, { ImageColor3 = col }, 0.15) U.tw(i.txt, { TextColor3 = col }, 0.15) end

	-- ===== http, thumbnails, script providers =====
	local function httpGet(url)
		local ok, r = pcall(game.HttpGet, game, url, true)
		if ok and r and r ~= "" then return r end
		if request then
			local rr = request({ Url = url, Method = "GET" })
			if rr and rr.Body and rr.Body ~= "" then return rr.Body end
		end
		error("http failed: " .. url)
	end
	local function enc(s) return Sv.HttpService:UrlEncode(s) end
	local function absUrl(u, base)
		if type(u) ~= "string" or u == "" then return nil end
		if u:sub(1, 1) == "/" then return base .. u end
		return u
	end
	local gca = getcustomasset or getsynasset
	local function hash(s)
		local h = 5381
		for i = 1, #s do h = (h * 33 + s:byte(i)) % 4294967296 end
		return string.format("%08x", h)
	end
	function U.loadThumb(url, img)
		task.spawn(function()
			if not gca or not writefile then return end
			while U.thumbBusy >= 4 do task.wait(0.1) end
			U.thumbBusy = U.thumbBusy + 1
			local a = U.thumbCache[url]
			if not a then
				local path = K.cache .. "/" .. hash(url) .. ".png"
				if not (isfile and isfile(path)) then
					local ok, body = pcall(httpGet, url)
					if ok and type(body) == "string" and #body > 100 then pcall(writefile, path, body) end
				end
				local ok, r = pcall(gca, path)
				if ok and r then a = r U.thumbCache[url] = r end
			end
			U.thumbBusy = U.thumbBusy - 1
			if a and img.Parent then img.Image = a U.tw(img, { ImageTransparency = 0 }, 0.35) end
		end)
	end
	local P = {}
	U.P, U.PORDER = P, { "scriptblox", "rscripts", "robloxscripts", "haxhell", "files" }
	P.scriptblox = { name = "ScriptBlox", fetch = function(q, p)
		local url = q ~= "" and ("https://scriptblox.com/api/script/search?q=" .. enc(q) .. "&page=" .. p .. "&max=20") or ("https://scriptblox.com/api/script/fetch?page=" .. p)
		local j, out = Sv.HttpService:JSONDecode(httpGet(url)), {}
		for _, s in ipairs((j.result and j.result.scripts) or {}) do
			out[#out + 1] = { title = s.title or "?", game = (s.game and s.game.name) or "Universal", verified = s.verified == true, key = s.key == true,
				views = s.views or 0, universal = s.isUniversal == true, src = "ScriptBlox", date = s.createdAt or "", code = s.script,
				thumb = absUrl(s.image or (s.game and s.game.imageUrl), "https://scriptblox.com") }
		end
		return out
	end }
	P.rscripts = { name = "RScripts", fetch = function(q, p)
		-- NEED: field names hedged. verify once: print(game:HttpGet(url))
		local url = "https://rscripts.net/api/v2/scripts?page=" .. p .. "&orderBy=date&sort=desc" .. (q ~= "" and ("&q=" .. enc(q)) or "")
		local j, out = Sv.HttpService:JSONDecode(httpGet(url)), {}
		for _, s in ipairs(j.scripts or {}) do
			local g = s.game
			out[#out + 1] = { title = s.title or "?", game = type(g) == "table" and (g.title or g.name) or tostring(g or "Universal"),
				verified = s.verified == true or (s.user and s.user.verified == true) or false, key = s.keySystem == true, views = s.views or 0,
				universal = g == nil, src = "RScripts", date = s.lastUpdated or s.createdAt or "", raw = s.rawScript,
				thumb = absUrl(s.image or s.thumbnail or (type(g) == "table" and (g.imgurl or g.image)), "https://rscripts.net") }
		end
		return out
	end }
	local function generic(name, key)
		return { name = name, fetch = function(q, p)
			local tpl = K.endpoints[key]
			if not tpl then error("no endpoint set (K.endpoints." .. key .. ")") end
			local url = (tpl:gsub("{q}", function() return enc(q) end):gsub("{p}", function() return tostring(p) end))
			local j = Sv.HttpService:JSONDecode(httpGet(url))
			local arr = (type(j) == "table" and j[1] and j) or j.scripts or j.data or (j.result and j.result.scripts) or {}
			local out = {}
			for _, s in ipairs(arr) do
				local g = s.game
				out[#out + 1] = { title = s.title or s.name or "?", game = type(g) == "table" and (g.name or g.title) or tostring(g or "Universal"),
					verified = s.verified == true, key = s.key == true or s.keySystem == true, views = s.views or 0, universal = false, src = name,
					date = s.createdAt or "", code = s.script, raw = s.rawScript or s.raw or s.url, thumb = absUrl(s.image or s.thumbnail or s.img, "") }
			end
			return out
		end }
	end
	P.robloxscripts, P.haxhell = generic("RobloxScripts", "robloxscripts"), generic("Haxhell", "haxhell")
