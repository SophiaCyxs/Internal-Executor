		local LB = new("Frame", { Size = UDim2.new(1, -36, 0, 54), Position = UDim2.fromOffset(18, 100 + 22 * n), BackgroundColor3 = C.bg, BackgroundTransparency = 0.3, BorderSizePixel = 0, ClipsDescendants = true }, Card)
