		local function hidePop() pop.Visible = false end
		local function accept(it)
			local cur = code.CursorPosition
			if cur < 1 then return end
			local txt = code.Text
			local before, after = txt:sub(1, cur - 1), txt:sub(cur)
			local word = before:match("[%w_]+$") or ""
			before = before:sub(1, #before - #word)
			local ins = it.body or it.name
			if ins:sub(1, 1) == ":" and before:sub(-1):match("[:%.]") then ins = ins:sub(2) end
			local ci2 = ins:find("|", 1, true)
			if ci2 then ins = ins:gsub("|", "", 1) end
			local off = ci2 and (ci2 - 1) or #ins
			guard = true
			code.Text = before .. ins .. after
			guard = false
			sync() hidePop()
			code:CaptureFocus()
			code.CursorPosition = #before + off + 1
		end
		local function showSug()
			if guard or not code:IsFocused() then hidePop() return end
			local cur = code.CursorPosition
			if cur < 1 then hidePop() return end
			local before = code.Text:sub(1, cur - 1)
			local word = before:match("[%w_]+$")
			if not word then hidePop() return end
			local lw, res = word:lower(), {}
			for _, it in ipairs(ITEMS) do
				if #it.name >= #word and it.name:sub(1, #word):lower() == lw and not (it.name == word and it.kind ~= "Snippet") then res[#res + 1] = it end
			end
			table.sort(res, function(a, b) if a.pr ~= b.pr then return a.pr < b.pr end return a.name:lower() < b.name:lower() end)
			while #res > 8 do table.remove(res) end
			if #res == 0 then hidePop() return end
			for _, r in ipairs(popRows) do r:Destroy() end
			popRows = {}
			for i, it in ipairs(res) do
				local r = new("TextButton", { Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 4 + (i - 1) * 26), BackgroundColor3 = C.hover, BackgroundTransparency = 1, Text = "", AutoButtonColor = true, BorderSizePixel = 0, ZIndex = 61 }, pop)
				corner(6, r)
				local sw = new("Frame", { Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(6, 7), BackgroundColor3 = KC[it.kind], BorderSizePixel = 0, ZIndex = 62 }, r)
