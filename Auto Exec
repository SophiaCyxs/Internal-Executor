			MinB = btn("-", 14, C.card, C.sub, { Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -72, 0, 12) }, TB)
			CloseB = btn("x", 12, C.card, C.sub, { Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -38, 0, 12) }, TB)
