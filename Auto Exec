		task.spawn(function()
			task.wait(0.4)
			for i, s in ipairs(stages) do
				print("[Arachnid] stage: " .. s[1])
				local r = rows[i]
				taskL.Text, r.stL.Text = s[1] .. "...", "running"
				U.tw(r.nameL, { TextColor3 = C.text }, 0.15)
				U.tw(r.mk, { BackgroundColor3 = U.A1 }, 0.15)
				local ts = os.clock()
				local ok, res = pcall(s[2], log)
				if ok then
					U.tw(r.mk, { BackgroundColor3 = C.green }, 0.2)
					r.stL.Text = (type(res) == "string" and (res .. "  |  ") or "") .. string.format("%.1fs", os.clock() - ts)
					r.stL.TextColor3 = C.sub
				else
					U.tw(r.mk, { BackgroundColor3 = C.red }, 0.2)
					r.stL.Text, r.stL.TextColor3 = "failed", C.red
					log(tostring(res), C.red)
					warn("[Arachnid] " .. s[1] .. ": " .. tostring(res))
				end
				U.tw(fill, { Size = UDim2.new(i / n, 0, 1, 0) }, 0.35)
				pctL.Text = math.floor(i / n * 100) .. "%"
				task.wait(0.18)
			end
			taskL.Text, taskL.TextColor3 = "done", C.green
			task.wait(0.35)
			bc:Disconnect()
			U.tw(sc, { Scale = U.vpScale(204 + 22 * n) * 1.05 }, 0.15)
			task.wait(0.15)
			Card:Destroy()
			onDone()
		end)
	end

